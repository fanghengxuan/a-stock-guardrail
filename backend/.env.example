OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=http://your-endpoint:8080/v1
LLM_MODEL=deepseek-v4-flash
# API 模式：必须 responses——系统设计主线（LLM 下钻取数 + 内置 web_search + output_type 主路径）
# 全依赖 Responses API，不许静默回退。端点须支持 /responses。
# LLM_API_MODE 仅作应急回滚开关：置回 chat_completions 会禁用 web_search 与 output_type 主路径
# （SDK 对 ChatCompletions 拒绝 hosted tool，drilldown 的 WebSearchTool 亦不会挂载），非日常配置。
LLM_API_MODE=responses
# 深度思考开关（默认关闭）：DeepSeek v4 默认长推理会让报告直写前 3-5 分钟零正文输出
# （前端实时渲染像假死）。关闭 → thinking:disabled，秒级出字、逐节点亮；
# 开启 → 保留深度推理（更缜密但慢）。1/true/on 开启，其余值=关闭。
LLM_DEEP_THINK=false
